# LiveKit Cloud project — the only credentials the agent needs
# (STT/LLM/TTS all run on LiveKit Inference under the same key).
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Where the agent POSTs the end-of-call debrief (the deployed Worker).
# Leave DEBRIEF_URL empty to skip debrief upload entirely.
DEBRIEF_URL=
DEBRIEF_TOKEN=

# Optional model overrides (LiveKit Inference model ids)
# COCKPIT_STT_MODEL=deepgram/nova-3
# COCKPIT_LLM_MODEL=openai/gpt-4.1-mini
# COCKPIT_TTS_MODEL=cartesia/sonic-3

# Cockpit build-time vars (cockpit/.env or CI):
# Ofcom reserves +44 7700 900xxx for documentation — a fork should point these
# at its own trunk, never at the number baked into cockpit/src/config.ts.
# VITE_PHONE_NUMBER=+447700900123    # E.164; shown on the hero placard
# VITE_PHONE_DISPLAY=+44 7700 900123
# VITE_REPO_URL=https://github.com/...

# Hard cap on a single call. Nothing else ends a call — the room outlives the
# session and agent session minutes are metered — so this bounds the worst case.
# Set COCKPIT_MAX_CALL_SECONDS=0 to disable the cap entirely.
# COCKPIT_MAX_CALL_SECONDS=300
# COCKPIT_CAP_WARNING_SECONDS=30    # spoken warning this long before the cap
